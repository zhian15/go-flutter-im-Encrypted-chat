# ===== 本机 go run 配置：连接到 docker-compose 暴露到 127.0.0.1 的端口 =====
# （密码和 deploy/.env 中的 MYSQL_PASSWORD / MINIO_* 保持一致）

APP_ENV=dev
HTTP_PORT=8080
WS_PORT=9090
NODE_ID=node-a

# MySQL（docker im-mysql 映射到 127.0.0.1:3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Im@2026dev
MYSQL_DB=im
MYSQL_DSN=root:Im@2026dev@tcp(127.0.0.1:3306)/im?charset=utf8mb4&parseTime=True&loc=UTC

# Redis（docker im-redis 映射到 127.0.0.1:6379）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB（docker im-mongo 映射到 127.0.0.1:27017）
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=im
MONGO_USER=
MONGO_PASSWORD=

# MinIO（docker im-minio 映射到 127.0.0.1:9000/9001）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=im-files
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# 认证
JWT_SECRET=dev_please_change_in_prod_0123456789abcdef
JWT_ACCESS_TTL_HOURS=24
JWT_REFRESH_TTL_DAYS=30
AUTH_MODE=none
INVITE_CODE_ENABLED=false
REGISTER_ENABLED=true
E2E_ENABLED=false
E2E_MASTER_KEY=

# 慢客户端踢连接开关（开启后写缓冲满→踢连接→重连→补拉自愈，数据不丢；代价：弱网偶发「连接中」）
KICK_SLOW_CLIENTS=true

# 首个管理员（首次启动自动创建）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# TRTC / 短信 / 邮箱（按需填，默认留空不启用）
TRTC_APP_ID=
TRTC_SECRET_KEY=
TRTC_REGION=ap-guangzhou
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET_KEY=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_INTERNATIONAL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 接入节点（客户端启动拉取）
ACCESS_NODES=[{"id":"node-a","name":"本地节点","wss":"ws://127.0.0.1:9090/ws","api":"http://127.0.0.1:8080","weight":100}]
