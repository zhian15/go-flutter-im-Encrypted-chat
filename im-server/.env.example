# ===== 服务 =====
APP_ENV=dev
HTTP_PORT=8080            # api 服务端口
WS_PORT=9090              # gateway 长连接端口
NODE_ID=node-a            # 当前节点标识（就近接入节点列表用）

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DB=im
MYSQL_DSN=root:change_me@tcp(127.0.0.1:3306)/im?charset=utf8mb4&parseTime=True&loc=UTC

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=im
MONGO_USER=
MONGO_PASSWORD=

# ===== MinIO 文件存储 =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=im-files
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# ===== 认证 =====
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_ACCESS_TTL_HOURS=2
JWT_REFRESH_TTL_DAYS=7
# 认证模式：none / sms / email
AUTH_MODE=none
# 邀请码开关：true / false
INVITE_CODE_ENABLED=false
# 注册开关
REGISTER_ENABLED=true
# 端到端加密开关（服务端可解密）
E2E_ENABLED=false
# E2E 服务端根密钥（保密！）
E2E_MASTER_KEY=

# ===== 第一个管理员（部署时初始化） =====
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# ===== 腾讯云 TRTC（国内站） =====
TRTC_APP_ID=
TRTC_SECRET_KEY=
TRTC_REGION=ap-guangzhou

# ===== 阿里云短信 =====
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET_KEY=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_INTERNATIONAL_ENABLED=false

# ===== SMTP 邮箱 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== 就近接入节点列表 =====
# JSON 数组：客户端启动拉取后测速选路
ACCESS_NODES=[{"id":"node-a","name":"华东-主节点","wss":"wss://im.example.com/ws","api":"https://im.example.com","weight":100}]
